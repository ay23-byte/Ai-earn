# Reference only: the application reads process environment variables, not this file automatically.
# Allowed values: development, test, production. Production is not deployment-ready.
AI_EARN_ENV=development
# Allowed values: DEBUG, INFO, WARNING, ERROR.
AI_EARN_LOG_LEVEL=INFO
# Required for experimental offline authentication and state storage; set in the
# environment, not this file. Both must be absolute paths in a single private
# owner-only directory (POSIX 0700 / Windows protected ACL).
# AI_EARN_AUTH_DB=/absolute/path/to/private-directory/auth.sqlite3
# AI_EARN_STATE_DB=/absolute/path/to/private-directory/state.sqlite3
